# StatusDeck Environment Variables Reference
# ==========================================

# Region & Deployment Configuration
AWS_REGION=ap-south-1
NODE_ENV=development
PORT=4000

# DynamoDB Table Names
DYNAMODB_TABLE_TENANTS=StatusDeck-Tenants-dev
DYNAMODB_TABLE_MONITORS=StatusDeck-Monitors-dev
DYNAMODB_TABLE_RESULTS=StatusDeck-CheckResults-dev
DYNAMODB_TABLE_INCIDENTS=StatusDeck-Incidents-dev

# Local DynamoDB Endpoint (leave empty for live AWS DynamoDB)
# When set to http://localhost:8000 or using local mock, queries bypass AWS credentials
DYNAMODB_ENDPOINT=http://localhost:8000

# Amazon Cognito Configuration
COGNITO_USER_POOL_ID=ap-south-1_example123
COGNITO_CLIENT_ID=exampleclientid1234567890
COGNITO_REGION=ap-south-1

# SNS Configuration for Incident Alerts
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:StatusDeck-Alerts-dev

# Frontend API Endpoint (consumed by Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_COGNITO_USER_POOL_ID=ap-south-1_example123
VITE_COGNITO_CLIENT_ID=exampleclientid1234567890
VITE_COGNITO_REGION=ap-south-1
